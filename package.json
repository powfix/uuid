{
  "name": "@powfix/uuid",
  "version": "0.3.0",
  "description": "UUID creation, comparison, and UUID-value maps and sets",
  "keywords": [
    "uuid",
    "rfc4122",
    "rfc9562"
  ],
  "homepage": "https://github.com/powfix/uuid#readme",
  "bugs": {
    "url": "https://github.com/powfix/uuid/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/powfix/uuid.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "compile": "tsc",
    "bundle": "tsup --config tsup.config.ts",
    "prebuild": "npm run clean",
    "build": "npm run compile && npm run bundle && npm run build:dts",
    "build:dts": "tsc -p tsconfig.declaration.json && node scripts/cjs-declarations.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "files": [
    "dist",
    "AUTHORS",
    "LICENSE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "require": {
        "types": "./dist/index.node.d.cts",
        "default": "./dist/index.node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@types/node": "^24.5.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "esbuild": "^0.27.1"
  },
  "peerDependencies": {},
  "sideEffects": false
}
